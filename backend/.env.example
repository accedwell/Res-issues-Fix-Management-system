PORT=5000
# Frontend address(es) allowed to call the API, comma-separated
CLIENT_URL=http://localhost:5173,http://localhost:5174
# PostgreSQL connection — the server will not start without it
DATABASE_URL="postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/resifix?schema=public"
# Secret used to sign login tokens (at least 32 characters). Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# Where the JSON data file lives (default: backend/data/db.json)
# DATA_FILE=data/db.json
# Testing helpers: reset codes shown on screen, phones on the same Wi-Fi allowed.
# Only on your own computer. Leave it out (or false) on a real server.
DEV_MODE=true
