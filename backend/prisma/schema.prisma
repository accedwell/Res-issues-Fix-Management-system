generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  MAINTENANCE
  ADMIN
  SYSADMIN
  // Assigns jobs to technicians, and can update a technician's availability for them.
  SUPERVISOR
}

enum IssueStatus {
  REPORTED
  RECEIVED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  ISSUE_CREATED
  ISSUE_ASSIGNED
  STATUS_UPDATED
  COMMENT_ADDED
  ISSUE_RESOLVED
  ISSUE_CLOSED
  SYSTEM
}

// How stock in the parts store changed.
enum StockChange {
  ADDED
  TAKEN
  RESTOCKED
}

enum HistoryAction {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  COMMENT_ADDED
  RESOLVED
  CLOSED
  REOPENED
}

model User {
  id             String   @id @default(cuid())
  fullName       String   @map("full_name")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  studentNumber  String?  @unique @map("student_number")
  phone          String?
  role           UserRole @default(STUDENT)
  blockId        String?  @map("block_id")
  roomNumber     String?  @map("room_number")
  // Maintenance staff only: the kind of job they handle (Plumbing, Electrical, ...).
  specialization String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  block          ResidenceBlock?    @relation(fields: [blockId], references: [id], onDelete: SetNull)
  reportedIssues MaintenanceIssue[] @relation("ReportedIssues")
  assignedIssues MaintenanceIssue[] @relation("AssignedIssues")
  notifications  Notification[]
  historyEntries IssueHistory[]
  feedback       IssueFeedback[]
  messages       IssueMessage[]
  passwordReset  PasswordReset?
  stockMovements StockMovement[]
  dutyShifts     DutyShift[]
  schedule       StaffSchedule?
  leave          StaffLeave[]

  @@index([role])
  @@index([blockId])
  @@map("users")
}

model ResidenceBlock {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  users  User[]
  issues MaintenanceIssue[]

  @@map("residence_blocks")
}

model IssueCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String   @default("dots")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  issues MaintenanceIssue[]

  @@map("issue_categories")
}

model MaintenanceIssue {
  id          String        @id @default(cuid())
  reference   String        @unique
  title       String
  description String        @db.Text
  status      IssueStatus   @default(REPORTED)
  priority    IssuePriority @default(MEDIUM)

  reporterId          String  @map("reporter_id")
  assigneeId          String? @map("assignee_id")
  categoryId          String  @map("category_id")
  blockId             String  @map("block_id")
  roomNumber          String? @map("room_number")
  location            String?
  imageUrl            String? @map("image_url")
  hasPhoto            Boolean @default(false) @map("has_photo")
  // How many times the student said it was not fixed.
  reopenCount         Int     @default(0) @map("reopen_count")
  // Validated software report plus trusted session metadata; existing residence reports stay unchanged.
  systemReport        Json?   @map("system_report")
  chatbotSubmissionId String? @unique @map("chatbot_submission_id")

  reportedAt DateTime  @default(now()) @map("reported_at")
  assignedAt DateTime? @map("assigned_at")
  // When the assigned technician accepted the job (or the staff manager confirmed it by phone).
  // Empty while the job is waiting to be accepted; after 2 minutes the managers are told to call them.
  acceptedAt DateTime? @map("accepted_at")
  startedAt  DateTime? @map("started_at")
  resolvedAt DateTime? @map("resolved_at")
  closedAt   DateTime? @map("closed_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  reporter  User            @relation("ReportedIssues", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee  User?           @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)
  category  IssueCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  block     ResidenceBlock  @relation(fields: [blockId], references: [id], onDelete: Restrict)
  history   IssueHistory[]
  feedback  IssueFeedback?
  photo     IssuePhoto?
  messages  IssueMessage[]
  partsUsed StockMovement[]

  @@index([status])
  @@index([priority])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([categoryId])
  @@index([blockId])
  @@index([reportedAt])
  @@index([status, priority])
  @@map("maintenance_issues")
}

// The photo a student attached to a report (one per report), stored in the database.
model IssuePhoto {
  id        String   @id @default(cuid())
  issueId   String   @unique @map("issue_id")
  mimeType  String   @map("mime_type")
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  issue MaintenanceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@map("issue_photos")
}

// Chat on a report between the student and the staff member assigned to it.
model IssueMessage {
  id        String   @id @default(cuid())
  issueId   String   @map("issue_id")
  senderId  String   @map("sender_id")
  body      String   @db.Text
  // Whether the other person (the one who did not send it) has seen it.
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  issue  MaintenanceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sender User             @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt])
  @@map("issue_messages")
}

model IssueHistory {
  id        String        @id @default(cuid())
  issueId   String        @map("issue_id")
  userId    String?       @map("user_id")
  action    HistoryAction
  oldValue  String?       @map("old_value")
  newValue  String?       @map("new_value")
  comment   String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at")

  issue MaintenanceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  @@index([userId])
  @@map("issue_history")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  issueId   String?          @map("issue_id")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([issueId])
  @@map("notifications")
}

model IssueFeedback {
  id        String   @id @default(cuid())
  issueId   String   @unique @map("issue_id")
  userId    String   @map("user_id")
  // Optional: a student can confirm a fix without rating it.
  rating    Int?
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  issue MaintenanceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("issue_feedback")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// A pending "forgot password" request. Only a hash of the 6-digit code is stored.
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// A spare part kept in the maintenance store room (stove plates, taps, bulbs, ...).
model SparePart {
  id          String   @id @default(cuid())
  name        String   @unique
  // The kind of job it is for: an issue category key such as "electrical", or empty for general use.
  category    String?
  unit        String   @default("each")
  quantity    Int      @default(0)
  // When stock drops to this number, the staff manager is told to order more.
  minQuantity Int      @default(1) @map("min_quantity")
  // Where to find it, e.g. "Store room, shelf A1".
  location    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  movements StockMovement[]

  @@map("spare_parts")
}

// Every time stock goes in or out of the store: who, how many, and for which job.
model StockMovement {
  id        String      @id @default(cuid())
  partId    String      @map("part_id")
  userId    String?     @map("user_id")
  issueId   String?     @map("issue_id")
  type      StockChange
  // Positive when stock comes in, negative when it is taken out.
  change    Int
  // How many were left afterwards.
  balance   Int
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")

  part  SparePart         @relation(fields: [partId], references: [id], onDelete: Cascade)
  user  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  issue MaintenanceIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([partId, createdAt])
  @@index([userId])
  @@index([issueId])
  @@map("stock_movements")
}

// One stretch of work for a maintenance technician: from clocking in to clocking out.
// While clockOutAt is empty they are on duty, and only on-duty technicians are given new jobs.
model DutyShift {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  clockInAt  DateTime  @default(now()) @map("clock_in_at")
  clockOutAt DateTime? @map("clock_out_at")
  // True when the system clocked them out because they forgot.
  autoClosed Boolean   @default(false) @map("auto_closed")
  // A break in progress: no new jobs until breakUntil (or until they say they are back).
  breakStartedAt DateTime? @map("break_started_at")
  breakUntil     DateTime? @map("break_until")
  // Minutes of finished breaks in this shift, left out of hours worked.
  breakMinutes   Int       @default(0) @map("break_minutes")

  // Who clocked them in / out when it was done for them (e.g. a technician without a phone):
  // the supervisor's or system admin's name. Empty when they did it themselves.
  clockedInBy  String? @map("clocked_in_by")
  clockedOutBy String? @map("clocked_out_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clockOutAt])
  @@index([clockInAt])
  @@map("duty_shifts")
}

// A technician's own working days and hours, set by the staff manager. Without one, the team's
// work hours apply.
model StaffSchedule {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  // Weekdays worked, 0 = Sunday ... 6 = Saturday, e.g. "1,2,3,4,5".
  days      String
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_schedules")
}

// Days a technician is away (leave, sick, training). Dates are "YYYY-MM-DD", both days included.
model StaffLeave {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  startDate String   @map("start_date")
  endDate   String   @map("end_date")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@map("staff_leave")
}
